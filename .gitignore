# macOS
.DS_Store

# 機密情報ファイル
*.env           # 環境変数ファイル
*.key           # 秘密鍵ファイル
*.pem           # 証明書ファイル
*secret*        # "secret"を含むファイル
*credentials*   # 認証情報ファイル

# .config 関連の除外
.config/raycast/  # Raycast設定（トークン含む）

# Nix
result
result-*

# skill-creator の評価成果物（workspace）は追跡しない
config/.claude/skills/*-workspace/
!config/.claude/skills/cmux-workspace/

# Python テスト実行時のキャッシュ
__pycache__/
*.pyc

# Claude Code の worktree 置き場（--worktree / EnterWorktree が自動管理）
# ルート限定にする: 先頭 / が無いと追跡対象の config/.claude/worktrees/ にもマッチしてしまう
/.claude/worktrees/

# 旧・手動 worktree 置き場（.claude/worktrees/ へ統一済み。残骸対策で ignore を維持）
.worktrees/
